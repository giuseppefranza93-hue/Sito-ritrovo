---
/**
 * Membership.
 *
 * IMPORTANT — scope boundary. On the client's current site this section is a
 * live application: member registration, internal credit, PayPal top-ups, a
 * Code 39 barcode and an admin panel, all on PHP + MySQL. A static site cannot
 * host any of that.
 *
 * So this section explains the tessera and hands off to the existing
 * application via `urlIscrizione` below. Point that at whatever the client
 * ends up using — the current PHP page, or a new signup flow. See README.
 */
import { Image } from 'astro:assets';
import Section from './Section.astro';
import tessera from '../images/tessera.jpg';

// TODO: sostituire con l'URL reale della domanda di ammissione (app PHP esistente).
const urlIscrizione = '#contatti';

const passaggi = [
  {
    titolo: 'Compili la domanda',
    testo:
      'Dati anagrafici, codice fiscale e firma. Servono per la domanda di ammissione a socio: siamo un circolo, non un negozio.',
  },
  {
    titolo: 'Ricevi tessera e Statuto',
    testo: 'Ti arrivano via email la domanda da firmare e lo Statuto, insieme al tuo codice tessera.',
  },
  {
    titolo: 'Giochi quando vuoi',
    testo:
      'Con la tessera entri in tutte le serate, prenoti i tavoli e accedi agli eventi riservati ai soci.',
  },
];
---

<Section
  id="tessera"
  eyebrow="Tessera"
  titolo="Diventa socio del circolo"
  intro="Il Ritrovo è un circolo culturale: per giocare serve la tessera. Si compila una volta e vale per tutto l'anno associativo."
>
  <div class="mt-14 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <ol class="space-y-8">
        {
          passaggi.map((passaggio, index) => (
            <li class="flex gap-6">
              <span class="border-ottone/40 text-ottone font-display flex h-12 w-12 shrink-0 items-center justify-center rounded-full border text-xl font-semibold">
                {index + 1}
              </span>
              <div>
                <h3 class="text-xl font-semibold">{passaggio.titolo}</h3>
                <p class="mt-2 leading-relaxed text-crema/70">{passaggio.testo}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="border-notte-line mt-12 rounded-card border p-7">
        <h3 class="text-lg font-semibold">Cosa ti dà la tessera</h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            [
              'Accesso a tutte le serate del circolo',
              'Prenotazione dei tavoli e degli eventi',
              'Credito interno per tavoli e consumazioni',
              'Eventi e tornei riservati ai soci',
            ].map((voce) => (
              <li class="flex items-start gap-3 text-crema/75">
                <span class="bg-ottone mt-2 h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true" />
                {voce}
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={urlIscrizione}
        class="bg-ottone text-notte hover:bg-ottone-chiaro mt-10 inline-flex rounded-full px-7 py-4 font-semibold transition-colors"
      >
        Crea la tua tessera
      </a>
    </div>

    <div class="lg:col-span-5">
      <Image
        src={tessera}
        alt="La Compagnia Card"
        widths={[420, 768, 1400]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/3] w-full rounded-card object-cover shadow-lift"
      />

      <div class="bg-notte-raised border-notte-line mt-8 rounded-card border p-7">
        <p class="eyebrow">Compagnia Card</p>
        <p class="mt-3 leading-relaxed text-crema/70">
          La tessera ha un codice a barre che la cassa legge con un normale lettore, e un credito interno che puoi
          ricaricare in sede o online.
        </p>
        <p class="mt-4 text-sm text-crema/50">
          I dati della domanda servono solo per il libro soci e per lo Statuto. La firma viene cancellata dopo l'invio.
        </p>
      </div>
    </div>
  </div>
</Section>
