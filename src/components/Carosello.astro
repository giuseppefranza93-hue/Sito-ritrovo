---
/**
 * The gallery carousel — the centre of the page.
 *
 * Design notes:
 * - Slides are sized to leave a deliberate "peek" of the next photo, which
 *   signals it is swipeable without needing an instruction.
 * - No autoplay. Photos that move on their own are the fastest way to make a
 *   site feel cheap, and they fight the user on touch devices.
 * - Progressive enhancement: without JavaScript this stays a native
 *   scroll-snap strip, so it is still usable.
 */
import { Image } from 'astro:assets';
import { didascalie } from '../data/galleria';

const modules = import.meta.glob<{ default: ImageMetadata }>('../images/galleria/*.jpg', { eager: true });

const slides = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => {
    const filename = path.split('/').pop()!;
    return { src: module.default, caption: didascalie[filename] ?? '', filename };
  });
---

<section id="galleria" class="bg-notte py-section lg:py-section-lg" aria-labelledby="galleria-titolo">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <header class="max-w-xl">
        <p class="eyebrow">Il locale</p>
        <h2 id="galleria-titolo" class="mt-3 text-3xl leading-tight font-semibold sm:text-4xl lg:text-5xl">
          Dai un'occhiata prima di venire
        </h2>
      </header>

      <!-- Controls sit next to the heading on desktop, under the strip on mobile. -->
      <div class="hidden items-center gap-3 md:flex">
        <button type="button" data-carosello-prev class="carousel-button" aria-label="Foto precedente">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11 3 5 9l6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button type="button" data-carosello-next class="carousel-button" aria-label="Foto successiva">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="m7 3 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    class="mt-10 lg:mt-14"
    data-carosello
    role="region"
    aria-roledescription="carosello"
    aria-label="Foto del locale"
    tabindex="0"
  >
    <div class="carousel-viewport" data-carosello-viewport>
      <div class="carousel-track">
        {
          slides.map((slide, index) => (
            <figure class="carousel-slide" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} di ${slides.length}`}>
              <div class="bg-notte-raised overflow-hidden rounded-card shadow-lift">
                <Image
                  src={slide.src}
                  alt={slide.caption || `Foto del locale ${index + 1}`}
                  widths={[480, 768, 1200, 1600]}
                  sizes="(min-width: 1280px) 42vw, (min-width: 768px) 55vw, 85vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="aspect-video h-full w-full object-cover"
                />
              </div>
              {slide.caption && (
                <figcaption class="mt-4 text-sm leading-relaxed text-crema/65">{slide.caption}</figcaption>
              )}
            </figure>
          ))
        }
      </div>
    </div>

    <div class="container-page mt-8">
      <div class="flex items-center justify-between gap-6">
        <div class="flex flex-wrap gap-2" data-carosello-dots role="tablist" aria-label="Scegli una foto"></div>

        <div class="flex items-center gap-3 md:hidden">
          <button type="button" data-carosello-prev class="carousel-button" aria-label="Foto precedente">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M11 3 5 9l6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" data-carosello-next class="carousel-button" aria-label="Foto successiva">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="m7 3 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .carousel-viewport {
    overflow: hidden;
    /* Fallback for no-JS: a native snapping scroller. Embla overrides this. */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  /* Once Embla is running it owns the scrolling, so drop the native behaviour. */
  [data-carosello].is-ready .carousel-viewport {
    overflow-x: hidden;
    scroll-snap-type: none;
  }

  .carousel-track {
    display: flex;
    gap: 1.25rem;
    /* Aligns the first and last slide with the page gutter. */
    padding-inline: 1.25rem;
  }

  .carousel-slide {
    flex: 0 0 85%;
    min-width: 0;
    scroll-snap-align: center;
  }

  @media (width >= 48rem) {
    .carousel-track {
      gap: 1.75rem;
      padding-inline: 2rem;
    }

    .carousel-slide {
      flex-basis: 55%;
    }
  }

  @media (width >= 80rem) {
    .carousel-slide {
      flex-basis: 42%;
    }
  }

  .carousel-button {
    display: inline-flex;
    height: 3rem;
    width: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid --alpha(var(--color-crema) / 25%);
    color: var(--color-crema);
    transition:
      background-color 200ms,
      border-color 200ms,
      color 200ms;
  }

  .carousel-button:hover {
    background-color: var(--color-rosso);
    border-color: var(--color-rosso);
    color: var(--color-crema);
  }

  .carousel-dot {
    height: 0.5rem;
    width: 1.5rem;
    border-radius: 9999px;
    background-color: --alpha(var(--color-crema) / 22%);
    transition:
      background-color 200ms,
      width 200ms;
  }

  .carousel-dot[aria-selected='true'] {
    width: 2.75rem;
    background-color: var(--color-rosso);
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  const root = document.querySelector<HTMLElement>('[data-carosello]');
  const viewport = root?.querySelector<HTMLElement>('[data-carosello-viewport]');

  if (root && viewport) {
    const embla = EmblaCarousel(viewport, {
      loop: true,
      align: 'center',
      containScroll: 'trimSnaps',
      skipSnaps: false,
    });

    root.classList.add('is-ready');

    const wire = (selector: string, action: () => void) =>
      root.querySelectorAll<HTMLButtonElement>(selector).forEach((button) => button.addEventListener('click', action));

    wire('[data-carosello-prev]', () => embla.scrollPrev());
    wire('[data-carosello-next]', () => embla.scrollNext());

    // Arrow keys work when the carousel itself has focus.
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        embla.scrollPrev();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        embla.scrollNext();
      }
    });

    const dotsContainer = root.querySelector<HTMLElement>('[data-carosello-dots]');
    if (dotsContainer) {
      const dots = embla.scrollSnapList().map((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'carousel-dot';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Vai alla foto ${index + 1}`);
        dot.addEventListener('click', () => embla.scrollTo(index));
        dotsContainer.append(dot);
        return dot;
      });

      const syncDots = () => {
        const selected = embla.selectedScrollSnap();
        dots.forEach((dot, index) => dot.setAttribute('aria-selected', String(index === selected)));
      };

      embla.on('select', syncDots);
      embla.on('reInit', syncDots);
      syncDots();
    }
  }
</script>
