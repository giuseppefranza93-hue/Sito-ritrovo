---
/**
 * The Compagnia Card.
 *
 * Redrawn in the club's own colours. The existing app renders it as a
 * purple-to-magenta gradient, which belongs to no part of the brand — the
 * poster and the logo are black, red and cream, so the card is too.
 *
 * The barcode keeps a cream plate behind it on purpose: barcode scanners need
 * dark bars on a light ground, so this is the one element that cannot follow
 * the dark theme without breaking at the till.
 */
import { code39 } from '../lib/code39';
import Logo from './Logo.astro';

interface Props {
  intestatario: string;
  codice: string;
  credito?: string;
  stato?: string;
  class?: string;
}

const { intestatario, codice, credito = '0,00 €', stato = 'Online', class: className = '' } = Astro.props;

const barcode = code39(codice, { narrow: 2, ratio: 3, height: 110 });
---

<div
  class:list={[
    'relative isolate overflow-hidden rounded-card border border-rosso/40 bg-notte-raised p-6 text-crema shadow-lift-lg sm:p-8',
    className,
  ]}
>
  <!-- Faint moon-and-sword watermark, the same mark as the signage. -->
  <Logo variante="marchio" fondo="scuro" class="pointer-events-none absolute -right-10 -bottom-12 w-56 opacity-[0.06]" />

  <div class="relative flex items-start justify-between gap-4">
    <div>
      <p class="font-display text-2xl leading-none font-semibold">Compagnia Card</p>
      <p class="mt-3 text-xl font-semibold">{intestatario}</p>
      <p class="mt-1 font-mono text-sm tracking-widest text-crema/60">{codice}</p>
    </div>

    <span class="border-rosso/50 text-rosso-chiaro shrink-0 rounded-full border px-3 py-1 text-xs font-semibold">
      {stato}
    </span>
  </div>

  <figure class="relative mt-7 rounded-lg bg-[#fdf6e6] p-4">
    <svg
      viewBox={`0 0 ${barcode.width} ${barcode.height}`}
      width="100%"
      height="88"
      preserveAspectRatio="none"
      role="img"
      aria-label={`Codice a barre della tessera ${codice}`}
    >
      {barcode.bars.map((bar) => <rect x={bar.x} y="0" width={bar.width} height={barcode.height} fill="#14100e" />)}
    </svg>
    <figcaption class="mt-2 text-center font-mono text-xs tracking-[0.3em] text-[#14100e]">{codice}</figcaption>
  </figure>

  <div class="relative mt-7 flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-crema/50 uppercase">Credito disponibile</p>
      <p class="font-display mt-1 text-3xl font-semibold tabular-nums">{credito}</p>
    </div>
    <slot name="azione" />
  </div>
</div>
