---
/**
 * "Il circolo" — the manifesto and the four things the club actually does.
 *
 * The copy is the client's own: the motto, the promise, and the four pillars
 * (board games, Pokémon, Magic & Commander, atmosphere) come from their site.
 */
import { Image } from 'astro:assets';
import Section from './Section.astro';
import circolo from '../images/circolo.jpg';
import { site } from '../data/site';

const pilastri = [
  {
    titolo: 'Giochi da tavolo',
    testo:
      'Dai party game veloci alle campagne strategiche. Tavoli liberi, serate demo e consigli per scegliere il gioco giusto.',
  },
  {
    titolo: 'Carte Pokémon',
    testo:
      'Scambi, partite amichevoli, mini tornei e giornate dedicate ai più giovani con supporto alle prime partite.',
  },
  {
    titolo: 'Magic e Commander',
    testo: 'Serate Commander, draft dimostrativi e tavoli casual per chi vuole giocare senza fretta e senza pressione.',
  },
  {
    titolo: 'Atmosfera da compagnia',
    testo: 'Un luogo fisico dove ritrovarsi, parlare, provare giochi nuovi e costruire una community locale.',
  },
];
---

<Section
  id="circolo"
  eyebrow="Il circolo"
  titolo="Un circolo per giocare, scambiare e conoscersi"
  intro="Non serve saper giocare e non serve arrivare in compagnia. Si entra, si prende un tavolo e qualcuno ti spiega le regole."
>
  <div class="mt-14 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <Image
        src={circolo}
        alt="Il circolo"
        widths={[480, 768, 1400]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/3] w-full rounded-card object-cover shadow-lift"
      />

      <!-- The client's motto, given the weight it deserves. -->
      <figure class="border-ottone mt-10 border-l-2 pl-6">
        <blockquote class="font-display text-2xl leading-snug font-semibold sm:text-3xl">
          {site.motto}
        </blockquote>
        <figcaption class="mt-3 text-sm text-crema/60">Il nostro manifesto</figcaption>
      </figure>
    </div>

    <div class="lg:col-span-7">
      <ul class="grid gap-px overflow-hidden rounded-card bg-notte-line sm:grid-cols-2">
        {
          pilastri.map((pilastro) => (
            <li class="bg-notte-raised p-7">
              <h3 class="text-xl font-semibold">{pilastro.titolo}</h3>
              <p class="mt-3 leading-relaxed text-crema/70">{pilastro.testo}</p>
            </li>
          ))
        }
      </ul>

      <div class="border-notte-line mt-8 rounded-card border p-7">
        <p class="eyebrow">La nostra promessa</p>
        <p class="font-display mt-3 text-2xl font-semibold">{site.promessa}</p>
        <p class="mt-3 leading-relaxed text-crema/70">
          Fantasy sì, ma con tavoli pieni. Il gioco è competitivo quando serve, accogliente sempre.
        </p>
      </div>
    </div>
  </div>
</Section>
