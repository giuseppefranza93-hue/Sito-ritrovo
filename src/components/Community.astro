---
/**
 * Community: the week's rhythm, the house rules, and where to follow along.
 * The rules text is the client's own.
 */
import Section from './Section.astro';
import { site, hoursInWeekOrder } from '../data/site';

const settimana = hoursInWeekOrder();
---

<Section
  id="community"
  eyebrow="Community"
  titolo={site.motto}
  intro="Un circolo inclusivo e non esclusivo: qui trovi il ritmo della settimana e le poche regole che ci teniamo a rispettare."
  tone="notte-raised"
>
  <div class="mt-14 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-6">
      <h3 class="text-sm font-semibold tracking-[0.18em] text-crema/50 uppercase">La settimana</h3>

      <dl class="mt-6">
        {
          settimana.map((giorno) => (
            <div
              class:list={[
                'border-notte-line flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b py-4',
                !giorno.opens && 'opacity-45',
              ]}
            >
              <dt class="font-display text-lg font-semibold">{giorno.label}</dt>
              <dd class="order-last w-full text-sm text-crema/60 sm:order-none sm:w-auto sm:flex-1 sm:px-6">
                {giorno.nota ?? ''}
              </dd>
              <dd class="text-sm font-medium tabular-nums">
                {giorno.opens ? `${giorno.opens} – ${giorno.closes === '24:00' ? '00:00' : giorno.closes}` : 'Chiuso'}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-5 text-sm text-crema/50">
        Orari indicativi: per eventi speciali e aperture straordinarie guarda gli eventi o Instagram.
      </p>
    </div>

    <div class="lg:col-span-6">
      <div class="border-notte-line rounded-card border p-7">
        <h3 class="text-xl font-semibold">Regole rapide</h3>
        <p class="mt-4 leading-relaxed text-crema/75">
          Rispetto dei tavoli, cura del materiale, partite inclusive, niente comportamenti tossici.
        </p>
        <p class="font-display text-ottone-chiaro mt-4 text-lg">
          Il gioco è competitivo quando serve, accogliente sempre.
        </p>
      </div>

      <div class="border-notte-line mt-5 rounded-card border p-7">
        <h3 class="text-xl font-semibold">Seguici</h3>
        <p class="mt-4 leading-relaxed text-crema/75">
          Foto delle serate, eventi e aggiornamenti finiscono su Instagram. È anche il modo più veloce per scriverci.
        </p>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener"
          class="border-crema/25 hover:border-ottone hover:text-ottone-chiaro mt-6 inline-flex items-center gap-2 rounded-full border px-5 py-3 font-semibold transition-colors"
        >
          {site.social.instagramHandle}
        </a>
      </div>
    </div>
  </div>
</Section>
