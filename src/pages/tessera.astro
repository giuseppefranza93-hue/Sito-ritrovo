---
/**
 * Area tessera — accesso e domanda di ammissione a socio.
 *
 * The existing app renders this as a modal over the one-page site. Here it is
 * its own page: the form is long, it is the site's main conversion point, and
 * a real URL can be linked from Instagram, WhatsApp or a QR code on the door,
 * which a modal cannot.
 *
 * SCOPE — this is the interface only. Creating an account, writing to the
 * database and emailing the signed application all belong to the club's PHP
 * backend. Point site.tesseramento.endpointRegistrazione at it and the form
 * posts there; until then the submit is disabled on purpose, because this form
 * collects a codice fiscale, a date of birth, an address and a signature, and
 * pretending to send those somewhere is worse than not offering the form.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CompagniaCard from '../components/CompagniaCard.astro';
import { site } from '../data/site';

const registrazioneAttiva = site.tesseramento.endpointRegistrazione.length > 0;
const accessoAttivo = site.tesseramento.endpointAccesso.length > 0;

/** Codice fiscale: 16 caratteri, con le lettere-omocodia ammesse al posto delle cifre. */
const CF_PATTERN = '[A-Za-z]{6}[0-9LMNPQRSTUVlmnpqrstuv]{2}[A-Za-z]{1}[0-9LMNPQRSTUVlmnpqrstuv]{2}[A-Za-z]{1}[0-9LMNPQRSTUVlmnpqrstuv]{3}[A-Za-z]{1}';

const campo =
  'border-crema/20 focus:border-rosso bg-notte mt-2 w-full rounded-lg border px-4 py-3 text-crema outline-none transition-colors placeholder:text-crema/30';
const etichetta = 'block text-sm font-semibold text-crema/80';
---

<BaseLayout
  title="Area tessera"
  description="Diventa socio de Il Ritrovo della Compagnia: compila la domanda di ammissione e ricevi la tua Compagnia Card."
>
  <div class="bg-notte pt-32 pb-section lg:pt-40">
    <div class="container-page">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
        <!-- Colonna sinistra: cosa sta per succedere e com'è fatta la tessera. -->
        <div class="lg:col-span-5">
          <p class="eyebrow">Area tessera</p>
          <h1 class="mt-3 text-4xl leading-tight font-semibold sm:text-5xl">Diventa socio del circolo</h1>
          <p class="mt-5 text-lg leading-relaxed text-crema/70">
            Il Ritrovo è un circolo affiliato {site.tesseramento.ente}: per giocare serve la tessera, obbligatoria a
            partire dai {site.tesseramento.etaMinima} anni.
          </p>

          <div class="border-rosso/40 bg-rosso/8 mt-8 rounded-card border p-6">
            <p class="text-sm leading-relaxed text-crema/80">
              I dati servono a precompilare la domanda di ammissione. Dopo la registrazione ricevi via email la domanda
              da firmare e lo Statuto.
            </p>
          </div>

          <CompagniaCard
            class="mt-8"
            intestatario="Ospite del Ritrovo"
            codice="IRC0000ANTEPRIMA"
            stato="Anteprima"
          />
          <p class="mt-3 text-sm text-crema/50">
            Esempio di tessera. Il codice a barre è in formato Code 39, lo stesso che legge il gestionale di cassa.
          </p>
        </div>

        <!-- Colonna destra: accesso e domanda. -->
        <div class="lg:col-span-7">
          <div class="border-notte-line rounded-card border p-6 sm:p-8">
            <div class="bg-notte grid grid-cols-2 gap-1 rounded-full p-1" role="tablist" aria-label="Area tessera">
              <button
                type="button"
                role="tab"
                id="tab-accedi"
                aria-controls="pannello-accedi"
                aria-selected="false"
                data-tab="accedi"
                class="rounded-full px-5 py-3 font-semibold transition-colors"
              >
                Accedi
              </button>
              <button
                type="button"
                role="tab"
                id="tab-registrati"
                aria-controls="pannello-registrati"
                aria-selected="true"
                data-tab="registrati"
                class="rounded-full px-5 py-3 font-semibold transition-colors"
              >
                Registrati
              </button>
            </div>

            <!-- ACCESSO -->
            <div id="pannello-accedi" role="tabpanel" aria-labelledby="tab-accedi" hidden class="mt-8">
              <form action={site.tesseramento.endpointAccesso || undefined} method="POST" class="grid gap-5">
                <div>
                  <label for="accesso-email" class={etichetta}>Email</label>
                  <input id="accesso-email" name="email" type="email" required autocomplete="email" class={campo} placeholder="nome@email.it" />
                </div>
                <div>
                  <label for="accesso-password" class={etichetta}>Password</label>
                  <input id="accesso-password" name="password" type="password" required autocomplete="current-password" class={campo} />
                </div>

                {
                  accessoAttivo ? (
                    <button type="submit" class="bg-rosso text-crema hover:bg-rosso-scuro mt-2 rounded-full px-7 py-3.5 font-semibold transition-colors">
                      Entra nell'area soci
                    </button>
                  ) : (
                    <p class="border-crema/15 mt-2 rounded-lg border border-dashed p-4 text-sm text-crema/60">
                      L'accesso all'area soci è gestito dall'applicazione del circolo. Va collegato prima di pubblicare —
                      vedi <code class="text-rosso-chiaro">endpointAccesso</code> nel README.
                    </p>
                  )
                }
              </form>
            </div>

            <!-- DOMANDA DI AMMISSIONE -->
            <div id="pannello-registrati" role="tabpanel" aria-labelledby="tab-registrati" class="mt-8">
              <form
                action={site.tesseramento.endpointRegistrazione || undefined}
                method="POST"
                class="grid gap-5"
                data-form-tessera
                novalidate={!registrazioneAttiva}
              >
                <div>
                  <label for="nome" class={etichetta}>Nome e cognome</label>
                  <input id="nome" name="nome" type="text" required autocomplete="name" class={campo} placeholder="Mario Rossi" />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label for="luogo-nascita" class={etichetta}>Luogo di nascita</label>
                    <input id="luogo-nascita" name="luogoNascita" type="text" required class={campo} placeholder="Comune di nascita" />
                  </div>
                  <div>
                    <label for="data-nascita" class={etichetta}>Data di nascita</label>
                    <input id="data-nascita" name="dataNascita" type="date" required class={campo} />
                  </div>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label for="comune" class={etichetta}>Comune di residenza</label>
                    <input id="comune" name="comuneResidenza" type="text" required autocomplete="address-level2" class={campo} placeholder="Comune" />
                  </div>
                  <div>
                    <label for="indirizzo" class={etichetta}>Indirizzo di residenza</label>
                    <input id="indirizzo" name="indirizzoResidenza" type="text" required autocomplete="street-address" class={campo} placeholder="Via, numero civico, CAP" />
                  </div>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label for="codice-fiscale" class={etichetta}>Codice fiscale</label>
                    <input
                      id="codice-fiscale"
                      name="codiceFiscale"
                      type="text"
                      required
                      maxlength="16"
                      pattern={CF_PATTERN}
                      class={`${campo} uppercase`}
                      placeholder="RSSMRA80A01H501U"
                      aria-describedby="cf-aiuto"
                    />
                    <p id="cf-aiuto" class="mt-1.5 text-xs text-crema/45">16 caratteri, senza spazi.</p>
                  </div>
                  <div>
                    <label for="telefono" class={etichetta}>Telefono</label>
                    <input id="telefono" name="telefono" type="tel" required autocomplete="tel" class={campo} placeholder="333 1234567" />
                  </div>
                </div>

                <div>
                  <label for="professione" class={etichetta}>Professione</label>
                  <input id="professione" name="professione" type="text" class={campo} placeholder="Professione o studente" />
                </div>

                <div>
                  <label for="tutore" class={etichetta}>
                    Nome e cognome del genitore o tutore{' '}
                    <span class="font-normal text-crema/50">— solo se il richiedente è minorenne</span>
                  </label>
                  <input id="tutore" name="tutore" type="text" class={campo} />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                  <div>
                    <label for="email" class={etichetta}>Email</label>
                    <input id="email" name="email" type="email" required autocomplete="email" class={campo} placeholder="nome@email.it" />
                  </div>
                  <div>
                    <label for="password" class={etichetta}>Password</label>
                    <input
                      id="password"
                      name="password"
                      type="password"
                      required
                      minlength="10"
                      autocomplete="new-password"
                      class={campo}
                      aria-describedby="password-aiuto"
                    />
                    <p id="password-aiuto" class="mt-1.5 text-xs text-crema/45">Almeno 10 caratteri.</p>
                  </div>
                </div>

                <!-- Firma. Il canvas scrive nell'input nascosto qui sotto. -->
                <fieldset class="border-notte-line mt-2 rounded-card border p-5">
                  <legend class="px-2 text-sm font-semibold text-crema/80">
                    Firma del richiedente oppure del genitore/tutore
                  </legend>

                  <canvas
                    data-firma
                    width="900"
                    height="300"
                    class="mt-3 w-full cursor-crosshair touch-none rounded-lg bg-[#fdf6e6]"
                    aria-label="Riquadro per la firma: firma con il dito o con il mouse"
                    role="img"></canvas>

                  <input type="hidden" name="firma" data-firma-input />

                  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm text-crema/60" data-firma-stato aria-live="polite">Firma non inserita</p>
                    <button
                      type="button"
                      data-firma-pulisci
                      class="border-crema/25 hover:bg-crema/10 rounded-full border px-5 py-2 text-sm font-semibold transition-colors"
                    >
                      Cancella firma
                    </button>
                  </div>

                  <p class="mt-3 text-xs leading-relaxed text-crema/45">
                    Firma direttamente nel riquadro. L'immagine viene inserita nella domanda e cancellata dal database
                    dopo l'invio dell'email. Se non riesci a firmare da qui, puoi firmare la domanda in sede.
                  </p>
                </fieldset>

                <label class="flex items-start gap-3 text-sm leading-relaxed text-crema/80">
                  <input type="checkbox" name="consensoAmmissione" required class="accent-rosso mt-1 h-4 w-4 shrink-0" />
                  <span>
                    Richiedo l'ammissione come socio e dichiaro di aver preso visione dello Statuto e dell'informativa
                    privacy allegata alla domanda.
                  </span>
                </label>

                <label class="flex items-start gap-3 text-sm leading-relaxed text-crema/80">
                  <input type="checkbox" name="consensoNewsletter" class="accent-rosso mt-1 h-4 w-4 shrink-0" />
                  <span>Voglio ricevere aggiornamenti su eventi, tornei e attività del circolo.</span>
                </label>

                {
                  registrazioneAttiva ? (
                    <button
                      type="submit"
                      class="bg-rosso text-crema hover:bg-rosso-scuro mt-3 rounded-full px-7 py-4 font-semibold transition-colors"
                    >
                      Crea tessera e invia documenti
                    </button>
                  ) : (
                    <div class="border-rosso/40 bg-rosso/8 mt-3 rounded-card border p-5">
                      <p class="font-semibold">Il modulo non è ancora collegato</p>
                      <p class="mt-2 text-sm leading-relaxed text-crema/70">
                        Qui viaggiano codice fiscale, data di nascita, indirizzo e firma: finché non è collegato al
                        gestionale del circolo, su un indirizzo <strong>https</strong>, il pulsante di invio resta
                        disattivato. Nel frattempo la tessera si fa in sede.
                      </p>
                      <a
                        href={`mailto:${site.email}?subject=${encodeURIComponent('Richiesta tesseramento')}`}
                        class="border-crema/25 hover:bg-crema/10 mt-4 inline-flex rounded-full border px-5 py-2.5 text-sm font-semibold transition-colors"
                      >
                        Scrivici per tesserarti
                      </a>
                    </div>
                  )
                }
              </form>
            </div>
          </div>

          <p class="mt-6 text-sm text-crema/50">
            <a href="/#tessera" class="underline underline-offset-4 hover:text-crema">Torna al sito</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // --- Tab accesso / registrazione -------------------------------------------
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const attivi = 'bg-rosso text-crema';
  const inattivi = 'text-crema/70 hover:text-crema';

  const mostra = (nome: string) => {
    for (const tab of tabs) {
      const selezionato = tab.dataset.tab === nome;
      tab.setAttribute('aria-selected', String(selezionato));
      tab.classList.toggle('bg-rosso', selezionato);
      tab.classList.toggle('text-crema', selezionato);
      tab.classList.toggle('text-crema/70', !selezionato);

      const pannello = document.getElementById(`pannello-${tab.dataset.tab}`);
      if (pannello) pannello.hidden = !selezionato;
    }
  };

  tabs.forEach((tab) => tab.addEventListener('click', () => mostra(tab.dataset.tab!)));
  mostra('registrati');

  // --- Riquadro della firma ---------------------------------------------------
  const canvas = document.querySelector<HTMLCanvasElement>('[data-firma]');
  const campoFirma = document.querySelector<HTMLInputElement>('[data-firma-input]');
  const stato = document.querySelector<HTMLElement>('[data-firma-stato]');
  const pulisci = document.querySelector<HTMLButtonElement>('[data-firma-pulisci]');

  if (canvas && campoFirma && stato && pulisci) {
    const ctx = canvas.getContext('2d')!;
    let disegna = false;
    let firmato = false;

    ctx.lineWidth = 3;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#14100e';

    /*
     * The canvas is a fixed 900×300 bitmap stretched by CSS, so pointer
     * coordinates have to be scaled from displayed pixels to bitmap pixels or
     * the ink lands away from the fingertip.
     */
    const punto = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      return {
        x: ((event.clientX - rect.left) / rect.width) * canvas.width,
        y: ((event.clientY - rect.top) / rect.height) * canvas.height,
      };
    };

    canvas.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      disegna = true;

      const p = punto(event);
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);

      /*
       * Pointer capture keeps the stroke alive if the finger slides outside the
       * box, but it throws on some synthetic/legacy pointers. Start the stroke
       * first and treat capture as optional, so a failure here cannot leave the
       * canvas unable to draw at all.
       */
      try {
        canvas.setPointerCapture(event.pointerId);
      } catch {
        /* capture non disponibile: si disegna comunque */
      }
    });

    canvas.addEventListener('pointermove', (event) => {
      if (!disegna) return;
      const p = punto(event);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();

      if (!firmato) {
        firmato = true;
        stato.textContent = 'Firma inserita';
      }
    });

    const fine = () => {
      if (!disegna) return;
      disegna = false;
      // Salvata solo al termine del tratto: fare toDataURL a ogni movimento
      // bloccherebbe il dito su un telefono.
      if (firmato) campoFirma.value = canvas.toDataURL('image/png');
    };

    canvas.addEventListener('pointerup', fine);
    canvas.addEventListener('pointercancel', fine);
    canvas.addEventListener('pointerleave', fine);

    pulisci.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      campoFirma.value = '';
      firmato = false;
      stato.textContent = 'Firma non inserita';
    });

    // Una domanda senza firma non è valida: meglio bloccarla qui che scoprirlo
    // dopo, quando è già partita l'email.
    document.querySelector<HTMLFormElement>('[data-form-tessera]')?.addEventListener('submit', (event) => {
      if (!firmato) {
        event.preventDefault();
        stato.textContent = 'Serve la firma per inviare la domanda';
        canvas.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    });
  }
</script>
